# Copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Connection string de tu cluster en MongoDB Atlas
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGO_URI=

# Nombre de la base de datos
DB_NAME=dolores_hidalgo_atencion_ciudadana

# Llave secreta que Botpress debe enviar en el header "x-api-key"
# para poder consumir este middleware. Genera una cadena aleatoria larga.
MIDDLEWARE_API_KEY=

# Puerto en el que correrá el servidor (Render/Railway lo asignan automático)
PORT=3000
